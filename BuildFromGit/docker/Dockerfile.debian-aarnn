# syntax=docker/dockerfile:1.7-labs
# Multi-stage build for AARNN (C++) on Ubuntu 24.04

ARG TARGET_PAGE_SIZE=4k
FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

# Install build toolchain and libraries, then use the official CMake 3.31.6 binary.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg wget xz-utils; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git build-essential ninja-build pkg-config \
      libssl-dev libcurl4-openssl-dev libgmp-dev libfftw3-dev \
      libpq-dev libpqxx-dev \
      libboost-all-dev \
      libopencv-dev \
      libgl1-mesa-dev libglu1-mesa-dev freeglut3-dev libglew-dev libfreetype6-dev libopengl-dev \
      libvtk9-dev \
      libopenmpi-dev \
      libasound2-dev portaudio19-dev libpulse-dev libsndfile1-dev \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      libcgal-dev libmpfr-dev libeigen3-dev libwebsocketpp-dev libasio-dev; \
    CMAKE_VER=3.31.6; CMAKE_DIR=/opt/cmake; ARCH=linux-x86_64; \
    curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VER}/cmake-${CMAKE_VER}-${ARCH}.tar.gz" -o /tmp/cmake.tgz; \
    mkdir -p "${CMAKE_DIR}"; \
    tar -xzf /tmp/cmake.tgz -C "${CMAKE_DIR}" --strip-components=1; \
    ln -sf "${CMAKE_DIR}/bin/cmake" /usr/local/bin/cmake; \
    ln -sf "${CMAKE_DIR}/bin/ctest" /usr/local/bin/ctest; \
    ln -sf "${CMAKE_DIR}/bin/cpack" /usr/local/bin/cpack; \
    ln -sf "${CMAKE_DIR}/bin/ccmake" /usr/local/bin/ccmake; \
    rm -f /tmp/cmake.tgz; \
    cmake --version; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build context should be the repository root.
COPY . /app/

RUN set -eux; \
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release; \
    cmake --build build --target AARNN -j; \
    (cmake --build build --target Visualiser -j || true); \
    cmake --install build --component Unspecified || true

FROM ubuntu:24.04 AS runtime
ARG TARGET_PAGE_SIZE
LABEL org.opencontainers.image.source="https://github.com/neuralmimicry/aarnn" \
      org.opencontainers.image.url="https://github.com/neuralmimicry/aarnn" \
      org.opencontainers.image.vendor="NeuralMimicry" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.page-size="${TARGET_PAGE_SIZE}" \
      org.opencontainers.image.description="AARNN runtime (Ubuntu 24.04)"

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libssl3 libcurl4 libgmp10 libfftw3-double3 \
      libpq5 libpqxx-dev \
      libopencv-dev \
      libgl1 libglx-mesa0 libgl1-mesa-dri libglu1-mesa libglew2.2 libfreetype6 \
      libvtk9-dev \
      libasound2-dev libportaudio2 libpulse0 libsndfile1 \
      libavcodec60 libavformat60 libavutil58 libswscale7 libswresample4 \
      libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
      ca-certificates bash; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /app/build/AARNN /app/AARNN
RUN --mount=from=build,src=/app/build,target=/srcbuild \
    bash -lc 'if [ -f /srcbuild/Visualiser ]; then cp /srcbuild/Visualiser /app/Visualiser; fi'
COPY configure/simulation.conf /app/simulation.conf
COPY configure/Visualiser.conf /app/Visualiser.conf
RUN chmod +x /app/AARNN && if [ -f /app/Visualiser ]; then chmod +x /app/Visualiser; fi

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["/app/AARNN"]
