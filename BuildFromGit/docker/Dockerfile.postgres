ARG TARGET_PAGE_SIZE=4k
FROM postgres:latest
ARG TARGET_PAGE_SIZE
LABEL org.opencontainers.image.page-size="${TARGET_PAGE_SIZE}"

ARG POSTGRES_USERNAME
ARG POSTGRES_PASSWORD
ARG POSTGRES_PORT_EXPOSE

ENV POSTGRES_USER=${POSTGRES_USERNAME}
ENV POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ENV POSTGRES_DB=neurons

COPY ./configure/init.sql /docker-entrypoint-initdb.d/

EXPOSE ${POSTGRES_PORT_EXPOSE}

# OCI metadata (final stage) so GHCR links the package to its source repository.
LABEL org.opencontainers.image.source="https://github.com/neuralmimicry/aarnn" \
      org.opencontainers.image.url="https://github.com/neuralmimicry/aarnn" \
      org.opencontainers.image.description="AARNN postgres image built from BuildFromGit (legacy C++ AARNN)" \
      org.opencontainers.image.vendor="NeuralMimicry" \
      org.opencontainers.image.licenses="GPL-3.0-only"
